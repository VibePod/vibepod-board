{
  "name": "vibepod-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planning board for refining ideas, syncing ready work, and exposing plans through UI, API, and MCP.",
  "scripts": {
    "dev": "cd backend && uv run uvicorn --factory vibepod_board.main:create_app --reload --host 0.0.0.0 --port 3000",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "test:api": "cd backend && uv run pytest",
    "typecheck": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
