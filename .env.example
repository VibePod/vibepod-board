# Optional. Enables the Push/Pull GitHub buttons (token needs Issues read/write).
# GITHUB_REPOSITORY is the default target when a task has no GitHub remote URL.
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPOSITORY=owner/repo
